<style>
    #player-wrapper {
        position: fixed;
        top: 0px; left: 0px;
        width: 1280px; height: 720px;
        background: black;
        overflow: hidden;
        z-index: 2000;
    }
    #player-container { width: 100%; height: 100%; }

    /* Single controls layer: hidden while playing, shown (visual only) while paused/error.
       Only the buttons receive clicks. */
    .player-controls {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 2100;
        opacity: 0;
        transition: opacity 0.4s ease;
        pointer-events: none;
    }
    #player-wrapper.is-paused .player-controls { opacity: 1; }

    .backBut {
        position: fixed;
        left: 612px;
        width: 55px;
        height: 55px;
        background: rgba(232, 8, 8, 0.7);
        border: 1px solid transparent;
        border-radius: 50%;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        outline: none;
        pointer-events: auto;
    }
    .backBut:hover { background: red; color: white; transform: scale(1.2); }
    #btn-play { top: 332px; }
    #btn-exit { top: 410px; }

    #msgBox {
        position: relative;
        top: -120px;
        background: rgba(0, 0, 0, 0.0);
        padding: 20px;
        border-radius: 10px;
        text-align: center;
        z-index: 2200;
        pointer-events: none;
    }

    /* Dimming layer shown while paused. It stops 60px short of the bottom so the
       YouTube control bar (gear icon, quality menu) stays clickable, as the TIP says. */
    #pause-overlay {
        position: fixed;
        top: 0; left: 0;
        width: 1280px;
        height: 660px;
        background: rgba(0, 0, 0, 0.6);
        z-index: 2040;
        display: none;
    }
    #player-wrapper.is-paused #pause-overlay { display: block; }

    .tip    { color: #00f2ff; font-size: 18px; }
    .error  { color: #fff0ffe3; font-weight: 400; font-size: 18px; }
    .action { color: #ffcc00; margin-top: 20px; font-size: 18px; }
</style>

<div id="player-wrapper">
    <div id="player-container"></div>
    <div id="pause-overlay"></div>

    <div class="player-controls">
        <div id="msgBox">
            <p class="tip">TIP: USE THE 'GEAR ICON' TO SELECT THE HIGHEST QUALITY AVAILABLE.</p>
            <p class="error" id="yt-error-text">VIDEO WON'T PLAY, IT MIGHT BE DUE TO AGE/REGION RESTRICTIONS OR IT HAS BEEN REMOVED.</p>
            <p class="action">RESTART VIDEO OR RETURN TO GRID</p>
        </div>

        <button type="button" id="btn-exit" class="backBut" onclick="exitPlayer()" title="Exit Player" aria-label="Exit Player">
            <svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>

        <button type="button" id="btn-play" class="backBut" onclick="resumePlay()" title="Restart Play" aria-label="Restart Play">
            <svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" stroke-width="2" fill="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="6 4, 20 12, 6 20, 6 4"></polygon>
            </svg>
        </button>
    </div>
</div>

<script>
// Everything lives inside one IIFE so re-injecting this template (handleNav) never
// hits "Identifier already declared" errors. Only exitPlayer / resumePlay / renderYTPlayer
// / cleanupYTPlayer are exposed on window.
(function () {
    // Tear down a previous instance (timers, socket handlers, player) before starting.
    if (typeof window.cleanupYTPlayer === 'function') {
        try { window.cleanupYTPlayer(); } catch (e) {}
    }

    // Server values go through JSON (not <%= %> inside quotes): correct for & ' " \ and newlines.
    const CFG = <%- JSON.stringify({
        origin:  (typeof origin   !== 'undefined' && origin)   ? String(origin)   : '',
        target:  (typeof targetID !== 'undefined' && targetID) ? String(targetID) : 'Live English News',
        scroll:  parseInt(typeof scrollPos !== 'undefined' ? scrollPos : 0, 10) || 0,
        menu:    (typeof menu     !== 'undefined' && menu)     ? String(menu)     : '',
        title:   (typeof title    !== 'undefined' && title)    ? String(title)    : '',
        videoId: (typeof videoId  !== 'undefined' && videoId)  ? String(videoId)  : ''
    }).replace(/</g, '\\u003c') %>;

    const video_id = CFG.videoId;
    const enc = encodeURIComponent;

    const hasSocket = () => typeof socket !== 'undefined' && !!socket;
    const emit = (ev, payload) => { if (hasSocket()) socket.emit(ev, payload); };
    const $el = (id) => document.getElementById(id);

    // Only same-site absolute paths ("/x"), never "//host" or "javascript:" or "https://...".
    const isSafePath = (u) => typeof u === 'string' && /^\/(?![\/\\])/.test(u);
    const navigate = (url) => {
        if (typeof handleNav === 'function') handleNav(url);
        else window.location.href = url;
    };

    const errEl = $el('yt-error-text');
    const DEFAULT_ERROR_TEXT = errEl ? errEl.textContent : '';
    const setErrorText = (txt) => { if (errEl) errEl.textContent = txt || DEFAULT_ERROR_TEXT; };

    // --- Timers: all tracked so cleanup() can cancel them --------------------------------------
    const timers = new Set();
    const later = (fn, ms) => {
        const id = setTimeout(() => { timers.delete(id); fn(); }, ms);
        timers.add(id);
        return id;
    };
    const clearAllTimers = () => { timers.forEach(clearTimeout); timers.clear(); };

    // --- Echo guard ------------------------------------------------------------------------------
    // While active, player state changes are NOT sent to the room. Uses a deadline (not a boolean)
    // so old timers can't switch off a newer lock.
    let remoteUntil = 0;
    const lockRemote = (ms = 1000) => { remoteUntil = Math.max(remoteUntil, Date.now() + ms); };
    let settling = false;      // true while the room join is being fine-tuned (nothing is emitted)
    let joinSync = null;
    const isRemote = () => settling || Date.now() < remoteUntil;
    let emitTimer = null;
    let unstartedTimer = null;
    let pauseUiTimer = null;
    let rateTimer = null;

    // --- Join sync: tune AFTER the video really starts ----------------------------------------
    // The initial seek is only exact at the instant it's requested; playback only advances once
    // buffering ends (~0.5-1.5 s). We measure that cost (stored for next time) and on the first
    // PLAYING fix the remaining drift with a slight playback-rate change (no new buffering).
    const LEAD_KEY = 'yt_join_lead';
    const getLead  = () => { try { return Math.min(1.5, Math.max(0, parseFloat(localStorage.getItem(LEAD_KEY)) || 0)); } catch (e) { return 0; } };
    const saveLead = (v) => { try { localStorage.setItem(LEAD_KEY, String(v)); } catch (e) {} };

    function finishJoinSync() {
        if (!joinSync && !settling) return;
        joinSync = null;
        settling = false;
        lockRemote(1500);   // absorb the last state events before emitting again
    }

    function startJoinSync(player, target, arrival) {
        joinSync = { target, arrival, tries: 0, lead: getLead(), seekAt: Date.now(), measured: false,
                     deadline: Date.now() + 10000 };
        settling = true;
        const expected = target + (Date.now() - arrival) / 1000;
        player.seekTo(expected + joinSync.lead, true);
        player.playVideo();
        later(finishJoinSync, 10000);   // safety net (e.g. autoplay blocked)
    }

    // A command from the room overrides any join tuning in progress. Otherwise a Pause/Play that
    // arrives while joining leaves `settling` on (up to 10 s), which blocks this client's own
    // emits and heartbeat, so pressing play on a paused room would not reach the others.
    function cancelJoinSync() {
        joinSync = null;
        settling = false;
    }

    function checkJoinDrift() {
        const p = window.ytPlayerInstance;
        if (!joinSync || !p) return;
        const playing = p.getPlayerState() === YT.PlayerState.PLAYING;
        if (!playing && Date.now() < joinSync.deadline) {
            later(checkJoinDrift, 400);   // still buffering
            return;
        }
        if (!playing) { finishJoinSync(); return; }   // deadline hit and not playing: nothing to tune

        const expected = joinSync.target + (Date.now() - joinSync.arrival) / 1000;
        const drift    = expected - p.getCurrentTime();   // > 0: this client is behind
        console.log(`[JoinSync] drift ${drift.toFixed(2)} s | lead ${joinSync.lead.toFixed(2)} s | try ${joinSync.tries}`);

        if (Math.abs(drift) <= 0.25) { finishJoinSync(); return; }

        if (Math.abs(drift) > 2.5 && joinSync.tries < 3 && Date.now() < joinSync.deadline) {
            joinSync.tries++;
            p.seekTo(expected + joinSync.lead, true);   // keep the measured lead: every seek re-buffers
            later(checkJoinDrift, 1500);
            return;
        }

        const rate  = drift > 0 ? (drift > 1.2 ? 1.5 : 1.25) : 0.75;
        const rates = p.getAvailablePlaybackRates ? p.getAvailablePlaybackRates() : [];
        if (rates.includes(rate) && Math.abs(drift) <= 2.5) {
            const ms = Math.min(8000, Math.abs(drift) / Math.abs(rate - 1) * 1000);
            p.setPlaybackRate(rate);
            clearTimeout(rateTimer);
            rateTimer = later(() => {
                const q = window.ytPlayerInstance;
                if (q && q.setPlaybackRate) q.setPlaybackRate(1);
            }, ms);
        } else if (joinSync.tries < 3 && Date.now() < joinSync.deadline) {
            joinSync.tries++;
            p.seekTo(expected + joinSync.lead, true);   // no alternative rates: seek, then re-check
            later(checkJoinDrift, 1500);
            return;
        }
        finishJoinSync();
    }

    // --- Playlist (sessionStorage) ---------------------------------------------------------------
    function readPlaylist() {
        try {
            const list = JSON.parse(sessionStorage.getItem('yt_playlist') || '[]');
            return Array.isArray(list) ? list : [];
        } catch (e) { return []; }
    }
    function clearPlaylist() {
        try { sessionStorage.removeItem('yt_playlist'); sessionStorage.removeItem('yt_playlist_index'); } catch (e) {}
    }
    // Returns true if it navigated to the next item.
    function advancePlaylist() {
        const list = readPlaylist();
        let index = 0;
        try { index = parseInt(sessionStorage.getItem('yt_playlist_index') || '0', 10) || 0; } catch (e) {}
        const next = index + 1;
        if (!list.length || next >= list.length) return false;
        try { sessionStorage.setItem('yt_playlist_index', String(next)); } catch (e) {}
        const menuParam = isSafePath(CFG.menu) ? CFG.menu : '';
        const url = `/tvytube?videoId=${enc(list[next])}&vq=hd1080&origin=link&targetID=playlist&menu=${enc(menuParam)}&scrollPos=0`;
        cleanup();
        navigate(url);
        return true;
    }

    // --- Player lifecycle ------------------------------------------------------------------------
    function purgePriorPlayer() {
        if (window.ytPlayerInstance) {
            try {
                window.ytPlayerInstance.stopVideo();
                window.ytPlayerInstance.destroy();
            } catch (e) { console.warn('Cleanup ignored:', e); }
            window.ytPlayerInstance = null;
        }
        if (window.heartbeatInterval) {
            clearInterval(window.heartbeatInterval);
            window.heartbeatInterval = null;
        }
        if (window.seekWatchInterval) {
            clearInterval(window.seekWatchInterval);
            window.seekWatchInterval = null;
        }
    }

    function cleanup() {
        clearAllTimers();
        joinSync = null;
        settling = false;
        purgePriorPlayer();
        if (hasSocket()) socket.off('Play').off('Pause');
        if (window.cleanupYTPlayer === cleanup) window.cleanupYTPlayer = null;
    }
    window.cleanupYTPlayer = cleanup;
    window.addEventListener('pagehide', cleanup, { once: true });

    // --- UI helpers ------------------------------------------------------------------------------
    function setPausedUI(on) {
        if (!on && window.ytPlayerError) return;   // keep the error screen up until playback really starts
        const wrapper = $el('player-wrapper');
        if (wrapper) wrapper.classList.toggle('is-paused', !!on);
    }

    function errorText(code) {
        switch (code) {
            case 2:   return 'INVALID VIDEO ID.';
            case 100: return 'THIS VIDEO WAS REMOVED OR IS PRIVATE.';
            case 101:
            case 150: return 'THE OWNER DOES NOT ALLOW THIS VIDEO TO BE PLAYED OUTSIDE YOUTUBE.';
            default:  return null;   // keeps the generic text
        }
    }

    // --- Exposed buttons -------------------------------------------------------------------------
    window.resumePlay = function () {
        const p = window.ytPlayerInstance;
        if (!p) return;
        if (window.ytPlayerError) {
            // A failed video can't be resumed: reload it. The PLAYING state change will tell the room.
            window.ytPlayerError = false;
            setErrorText(null);
            p.loadVideoById(video_id);
            return;
        }
        // Two-stage resume (same as the original behaviour):
        // 1) right now: tell the room to start from the exact paused frame, so every viewer starts
        //    its player at the same moment as this one (their start-up lag cancels this client's);
        // 2) ~200 ms later the PLAYING state change sends a refined position.
        // Without stage 1 the others only start after this client is already playing and stay a
        // few hundred ms behind.
        const pausedAt = p.getCurrentTime();
        p.playVideo();
        emit('toPlay', { time: pausedAt, videoId: video_id });
    };

    window.exitPlayer = function () {
        const { origin, target, scroll, menu, title } = CFG;
        const isChannel = /^UC[\w-]{22}$/.test(target);   // YouTube channel IDs: "UC" + 22 chars

        let returnUrl = '';
        if (origin === 'live-tv') {
            returnUrl = `/live-tv?genre=${enc(target)}&scrollPos=${scroll}`;
        } else if (origin === 'link') {
            returnUrl = isSafePath(menu) ? menu : '/youtube-menu';
        } else if (origin === 'music') {
            returnUrl = `/music-grid?genre=${enc(target)}&scrollPos=${scroll}&menu=${enc(menu)}&title=${enc(title)}`;
        } else if (origin === 'movies') {
            returnUrl = `/movies-grid?genre=${enc(target)}&scrollPos=${scroll}&menu=${enc(menu)}&title=${enc(title)}&isChannel=${enc(isChannel)}`;
        } else if (origin === 'youtube') {
            returnUrl = `/youtube-grid?genre=${enc(target)}&scrollPos=${scroll}&menu=${enc(menu)}&title=${enc(title)}&isChannel=${enc(isChannel)}`;
        } else {
            returnUrl = '/youtube-menu';   // unknown origin: never navigate to ""
        }

        clearPlaylist();
        cleanup();   // stop heartbeat, timers and socket handlers before leaving

        if (typeof handleNav === 'function') {
            window.pendingScrollRestore = scroll;
            handleNav(returnUrl);
        } else {
            window.location.href = returnUrl;
        }
    };

    // --- Early seek propagation ------------------------------------------------------------------
    // Same two-stage idea as resume. YouTube has no "seek" event, so a jump (progress bar, arrow
    // keys) is detected by comparing the playhead with where it should be (previous position +
    // elapsed time). The moment it happens the new position is sent to the room, so everyone starts
    // buffering it in parallel with this client; the PLAYING state change ~200 ms later then sends
    // the refined position (stage 2). Set SEEK_EARLY to false to turn this off.
    const SEEK_EARLY = true;
    const SEEK_JUMP  = 1.0;   // seconds: smaller differences count as normal playback/buffering

    function startSeekWatch() {
        if (!SEEK_EARLY) return;
        let lastT = null, lastState = null, lastWall = 0, lastEmit = 0;
        let pausedSeek = null;   // a seek made while paused: sent once the position stops moving

        window.seekWatchInterval = setInterval(() => {
            const p = window.ytPlayerInstance;
            if (!p || !p.getCurrentTime || !p.getPlayerState) return;
            const S = YT.PlayerState;
            let st, t;
            try { st = p.getPlayerState(); t = p.getCurrentTime(); } catch (e) { return; }
            const now = Date.now();

            // Seek made while paused (or while dragging the bar): send it once the position is stable
            if (pausedSeek) {
                if (st !== S.PAUSED || isRemote()) pausedSeek = null;
                else if (Math.abs(t - pausedSeek.t) < 0.05) {
                    if (++pausedSeek.stable >= 2) { emit('toPause', t); pausedSeek = null; }
                } else { pausedSeek.t = t; pausedSeek.stable = 0; }
            }

            if (lastT !== null && !window.ytPlayerError && !isRemote()) {
                const rate     = (p.getPlaybackRate && p.getPlaybackRate()) || 1;
                const expected = lastT + (lastState === S.PLAYING ? (now - lastWall) / 1000 * rate : 0);
                // The second condition ignores stalls: a frozen player has not jumped anywhere
                if (Math.abs(t - expected) > SEEK_JUMP && Math.abs(t - lastT) > 0.5) {
                    if (st === S.PAUSED) {
                        pausedSeek = { t, stable: 0 };
                    } else if ((st === S.PLAYING || st === S.BUFFERING) && now - lastEmit > 300) {
                        lastEmit = now;
                        pausedSeek = null;
                        emit('toPlay', { time: t, videoId: video_id });
                    }
                }
            }

            lastT = t; lastState = st; lastWall = now;
        }, 250);
    }

    // --- YouTube player --------------------------------------------------------------------------
    window.renderYTPlayer = function () {
        if (!video_id || !$el('player-container')) return;
        purgePriorPlayer();
        window.ytPlayerError = false;

        window.ytPlayerInstance = new YT.Player('player-container', {
            videoId: video_id,
            playerVars: {
                'autoplay': window.syncIsPaused ? 0 : 1,   // joining a paused room must not autostart
                'controls': 1,
                'rel': 0,
                'disablekb': 0,
                'fs': 0,
                'iv_load_policy': 3,
                'cc_load_policy': 0,
                'origin': window.location.origin,
                'enablejsapi': 1
            },
            events: {
                'onReady': (event) => {
                    if (window.syncTargetTime != null) {
                        const paused  = !!window.syncIsPaused;
                        const target  = window.syncTargetTime;
                        const arrival = window.syncArrivalTime || Date.now();
                        window.syncTargetTime = null;
                        window.syncIsPaused = null;
                        window.syncArrivalTime = null;

                        if (paused) {
                            // Paused video didn't advance: exact position, no elapsed time added
                            lockRemote(2500);
                            event.target.seekTo(target, true);
                            event.target.pauseVideo();
                        } else {
                            startJoinSync(event.target, target, arrival);
                        }
                    }

                    window.heartbeatInterval = setInterval(() => {
                        const p = window.ytPlayerInstance;
                        if (!p || !p.getCurrentTime || settling || !hasSocket()) return;   // don't report while syncing
                        let st;
                        try { st = p.getPlayerState(); } catch (e) { return; }
                        // BUFFERING/UNSTARTED/CUED are not "paused": reporting them would wipe the room state
                        if (st !== YT.PlayerState.PLAYING && st !== YT.PlayerState.PAUSED) return;
                        emit('report_current_time', {
                            time: p.getCurrentTime(),
                            paused: st !== YT.PlayerState.PLAYING,
                            videoId: video_id
                        });
                    }, 1000);

                    startSeekWatch();
                },

                'onError': (event) => {
                    console.error('YouTube Player Error:', event.data);
                    window.ytPlayerError = true;
                    setErrorText(errorText(event.data));
                    const wrapper = $el('player-wrapper');
                    if (wrapper) wrapper.classList.add('is-paused');

                    // In a playlist, don't get stuck on an unavailable video
                    if (readPlaylist().length) later(advancePlaylist, 2500);
                },

                'onStateChange': (event) => {
                    const S = YT.PlayerState;
                    const state = event.data;

                    if (state === S.PLAYING) {
                        window.ytPlayerError = false;
                        setErrorText(null);
                    }


                    // Join tuning: measure the startup cost on the first PLAYING, then check drift
                    if (joinSync && !joinSync.measured && state === S.PLAYING) {
                        joinSync.measured = true;
                        const measured = Math.min(2, (Date.now() - joinSync.seekAt) / 1000);
                        joinSync.lead = measured;
                        saveLead((getLead() + measured) / 2);
                        later(checkJoinDrift, 300);
                    }

                    // End of video: next in playlist, otherwise loop
                    if (state === S.ENDED) {
                        if (advancePlaylist()) return;
                        clearPlaylist();
                        event.target.seekTo(0);
                        event.target.playVideo();
                        return;
                    }

                    // UNSTARTED is normal during startup: only show the overlay if it stays stuck
                    // (e.g. autoplay blocked)
                    clearTimeout(unstartedTimer);
                    if (state === S.UNSTARTED) {
                        unstartedTimer = later(() => {
                            const p = window.ytPlayerInstance;
                            if (p && p.getPlayerState && p.getPlayerState() === S.UNSTARTED) setPausedUI(true);
                        }, 3000);
                    } else {
                        // YouTube fires short PAUSED events while starting, seeking or syncing.
                        // Only show the pause overlay if the player is still paused a moment later.
                        clearTimeout(pauseUiTimer);
                        if (state === S.PAUSED) {
                            pauseUiTimer = later(() => {
                                const p = window.ytPlayerInstance;
                                if (p && p.getPlayerState && p.getPlayerState() === S.PAUSED) setPausedUI(true);
                            }, 350);
                        } else {
                            setPausedUI(false);
                        }
                    }

                    // Socket: only PLAYING / PAUSED are sent. Other states (BUFFERING...) must not
                    // reset the debounce, or a real pause right before a seek would be lost.
                    if (isRemote()) return;
                    if (state !== S.PLAYING && state !== S.PAUSED) return;
                    clearTimeout(emitTimer);
                    emitTimer = later(() => {
                        const p = window.ytPlayerInstance;
                        if (!p) return;
                        // Send only what is still true: a PAUSED blip during startup/seek is dropped
                        if (p.getPlayerState() !== state) return;
                        const currentTime = p.getCurrentTime();
                        emit(state === S.PLAYING ? 'toPlay' : 'toPause', currentTime);
                    }, 200);
                }
            }
        });
    };

    if (!video_id) {
        // Nothing to play: say so instead of failing silently
        window.ytPlayerError = true;
        setErrorText('NO VIDEO SELECTED.');
        const wrapper = $el('player-wrapper');
        if (wrapper) wrapper.classList.add('is-paused');
    } else if (window.YT && window.YT.Player) {
        later(window.renderYTPlayer, 50);
    } else {
        window.onYouTubeIframeAPIReady = window.renderYTPlayer;
        if (!document.querySelector('script[src*="youtube.com/iframe_api"]')) {
            const s = document.createElement('script');
            s.src = 'https://www.youtube.com/iframe_api';
            s.onerror = () => { window.ytPlayerError = true; setErrorText('COULD NOT LOAD THE YOUTUBE PLAYER.'); setPausedUI(true); };
            document.head.appendChild(s);
        }
    }

    // --- Room sync: remote commands --------------------------------------------------------------
    if (hasSocket()) {
        socket.off('Play').off('Pause');

        socket.on('Play', (data) => {
            if (!window.ytPlayerInstance || !data) return;
            // The sender is already in this state: ignoring our own echo avoids stepping back ~RTT/2
            if (data.senderId && data.senderId === socket.id) return;

            const baseTime = parseFloat(data.timestamp);
            if (!isFinite(baseTime)) return;   // malformed payload: never jump to 0 by accident

            cancelJoinSync();
            lockRemote(1000);

            // lastUpdate is server-clock: convert "now" with the estimated offset
            // (window.serverTimeOffset), clamped to [0, 5] s so a bad estimate can't cause big jumps.
            const serverNow = Date.now() + (window.serverTimeOffset || 0);
            const latency   = Math.min(5, Math.max(0, (serverNow - (data.lastUpdate || serverNow)) / 1000));
            const actual    = baseTime + latency;

            console.log(`Syncing to: ${actual} (Base: ${baseTime}, Latency: ${latency})`);

            // Seek first, then play (some players reset to 0 if play() runs before the seek settles)
            window.ytPlayerInstance.seekTo(actual, true);
            later(() => { if (window.ytPlayerInstance) window.ytPlayerInstance.playVideo(); }, 50);
        });

        socket.on('Pause', (time) => {
            if (!window.ytPlayerInstance) return;
            const t = parseFloat(time);
            if (!isFinite(t)) return;
            cancelJoinSync();
            lockRemote(1000);
            window.ytPlayerInstance.seekTo(t, true);
            window.ytPlayerInstance.pauseVideo();
        });
    }
})();
</script>
