<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>TV Premium Settings</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />

<style>
    :root { 
        --accent: #ffa260; 
        --success: #2ecc71; 
        --error: #ff6b6b;
        --bg-panel: rgba(20, 20, 20, 0.55); 
        --glass-border: #ffffff6b;
        --text-main: #fff;
        --sidebar-width: 280px;
    }

    * { box-sizing: border-box; outline: none; margin: 0; padding: 0; }

    #settings_wrapper { 
        width: 1280px; height: 720px; color: var(--text-main); 
        font-family: 'Inter', sans-serif; position: relative; overflow: hidden; 
        display: flex; flex-direction: column;
        background: radial-gradient(circle at top right, rgba(45,30,20,0.5), rgba(5,5,5,0.95)); 
    }

    #main_header_area {
        flex-shrink: 0; height: 60px; display: flex; align-items: center; justify-content: flex-start;
        padding: 0 30px; border-bottom: 1px solid var(--glass-border); z-index: 20;
        background: rgba(0,0,0,0.4);
    }

    #main_header { 
        text-align: center; 
        font-size: 22px; 
        color: #fff; 
        text-transform: uppercase; 
        letter-spacing: 2px; 
        font-weight: 600; 
        margin-left: 170px;
    }

    #main_header span { color: var(--accent); }

    #connection-container {
        display: flex; align-items: center; gap: 10px;
        padding: 6px 14px; background: rgba(255,255,255,0.03);
        border-radius: 20px; border: 1px solid rgba(255,255,255,0.05);
    }

    #status-dot { width: 8px; height: 8px; background: var(--error); border-radius: 50%; box-shadow: 0 0 8px var(--error); }
    .online-active #status-dot { background: var(--success); box-shadow: 0 0 12px var(--success); }

    #workspace { display: flex; flex-grow: 1; height: 640px; overflow: hidden; }

    #sidebar {
        width: var(--sidebar-width); background: rgba(0, 0, 0, 0.3);
        border-right: 1px solid var(--glass-border); padding: 25px 15px;
        display: flex; flex-direction: column; gap: 8px; flex-shrink: 0;
    }

    .tab-btn {
        display: flex; align-items: center; gap: 14px; width: 100%;
        padding: 14px 18px; background: transparent; border: none;
        border-radius: 14px; color: rgba(255,255,255,0.6); font-family: 'Inter', sans-serif;
        font-size: 14px; font-weight: 500; text-align: left; cursor: pointer; transition: all 0.2s ease;
    }
    .tab-btn:hover { color: #fff; background: rgba(255,162,96,0.05); }
    .tab-btn.active {
        color: #000; background: var(--accent); font-weight: 600;
        box-shadow: 0 4px 20px rgba(255,162,96,0.25);
    }
    .tab-btn .material-symbols-rounded { font-size: 22px; }

    #content_area {
        flex-grow: 1; width: calc(1280px - var(--sidebar-width)); height: 100%;
        padding: 20px 100px; overflow: hidden; position: relative;
    }

    .conteiner-col { 
        display: none; width: 100%; height: 100%; gap: 70px; 
    }
    .conteiner-col.active { display: flex; animation: fadeIn 0.25s ease-out; }

    .sub-panel {
        flex: 1; background: black; border: 1px solid var(--glass-border);
        border-radius: 20px; padding: 20px 25px; display: flex; flex-direction: column;
        justify-content: flex-start; height: 100%; box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: scale(0.99); }
        to { opacity: 1; transform: scale(1); }
    }

    .section-title { 
        text-align: left; margin-bottom: 8px; font-weight: 600; font-size: 14px;
        color: var(--accent); text-transform: uppercase; letter-spacing: 0.08em;
        border-bottom: 2px solid #ffa260; padding-bottom: 6px;
    }

    .btn1 { 
        display: block; width: 100%; margin: 4px 0; padding: 11px 14px; 
        font-size: 14px; font-weight: 500; color: #fff; 
        background: rgba(255,255,255,0.03); border: 2px solid var(--glass-border);
        border-radius: 10px; cursor: pointer; transition: all 0.15s ease;
        font-family: 'Inter', sans-serif;
    }
    .btn1:hover { background: rgba(255,162,96,0.08); color: var(--accent); border-color: rgba(255,162,96,0.25); }

    .btn1.active {
        color: white!important;
        border-color: rgba(255,162,96,0.25)!important;
    }

    .btn1.active::before {
        content: ''; 
        display: inline-block; 
        width: 6px; 
        height: 6px;
        border-radius: 50%; 
        background: var(--accent); 
        margin-right: 8px;
        vertical-align: middle; 
        box-shadow: 0 0 6px var(--accent);
    }

    .btn2 { 
        padding: 10px; font-size: 14px; font-weight: 500; color: #fff; 
        background: rgba(255,255,255,0.03); border: 2px solid var(--glass-border);
        border-radius: 8px; cursor: pointer; transition: 0.15s; font-family: 'Inter', sans-serif;
    }
    .btn2:hover {background: rgba(255,162,96,0.08); color: var(--accent); border-color: rgba(255,162,96,0.25); }

    .sent { background: var(--success) !important; color: #000 !important; font-weight: 600; }

    .color-grid-static {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .color-square {
        width: 45px;
        height: 45px;
        border-radius: 6px;
        border: 2px solid transparent;
        cursor: pointer;
    }
    .color-square:hover { transform: scale(1.08); }
    .color-square.selected { border-color: #fff; box-shadow: 0 0 8px rgba(255,255,255,0.4); }

    .label-mini { font-size: 11px; font-weight: 600; color: rgba(255,255,255,0.35); text-transform: uppercase; margin: 12px 0 6px 2px; display: block; }

    .btn-group { 
        display: flex; 
        margin: 0px 0px; 
        background: rgba(0,0,0,0.2); 
        border-radius: 10px; 
        padding: 3px; 
        gap: 10px;
    }

    .ctrl-row { display: flex; align-items: stretch; margin-bottom: 10px; background: rgba(0,0,0,0.2); border-radius: 10px; padding: 6px; border: 1px solid var(--glass-border); }
    .btn-adj { width: 36px; height: 36px; font-size: 20px; font-weight: 700; color: rgba(255,255,255,0.5); background: rgba(255,255,255,0.02); border: none; border-radius: 6px; cursor: pointer; }
    .btn-adj:hover { background: rgba(255,162,96,0.12); color: var(--accent); }

    .btn-value { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .val-pct { font-size: 16px; font-weight: 600; color: var(--accent); }
    .val-sub { font-size: 12px; color: rgba(255,255,255,0.75); text-transform: uppercase; }

    .onoff-row, .neon-state-row { display: flex; gap: 6px; }

    .close-menu-btn {
        width: 40px; height: 40px; background: rgba(255,255,255,0.04); border: 1px solid var(--glass-border);
        border-radius: 10px; color: white; display: flex; align-items: center; justify-content: center; cursor: pointer;
    }
    .close-menu-btn:hover { background: #ff6b6b; border-color: #ff6b6b; }
    
    .legs-row {
        display: flex;
        gap: 10px;
        margin-top: 4px;
    }
    .legs-row .btn1 {
        flex: 1;
        margin: 0;
    }

    /* Botão Flutuante de Toggle no Canto */
#floating-toggle-btn {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9999;
    background: rgba(20, 20, 20, 0.75);
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 10px 14px;
    border-radius: 30px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: none; /* COMEÇA OCULTO (só aparece no modo SL Face) */
    align-items: center;
    gap: 8px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    backdrop-filter: blur(5px);
    transition: all 0.2s ease;
}

#floating-toggle-btn:hover {
    background: var(--accent);
    color: #000;
    transform: scale(1.05);
}
</style>
</head>
<body>
<div id="settings_wrapper">
    
    <!-- Top Header Bar -->
    <div id="main_header_area">
        <div id="connection-container" class="online-active">
            <div id="status-dot"></div>
            <div id="tv-info">
                <span id="status-text" style="font-size:11px; font-weight:600; color:#2ecc71;">ONLINE</span>
                <span id="warning-msg" style="margin-left: 30px; font-size: 12px; color: yellow; display: none;">If the settings do not work, turn the TV off and on again.</span>
            </div>
        </div>
        <h1 id="main_header">ON SCREEN <span>Settings</span></h1>
        <div style="top:10px;right: 20px;" class="close-menu-btn" onclick="closeSubMenu()">
            <span class="material-symbols-rounded">close</span>
        </div>
    </div>

    <!-- Main Workspace Setup -->
    <div id="workspace">
        
        <!-- Left Navigation Sidebar -->
        <div id="sidebar">
            <button class="tab-btn active" onclick="switchTab('frame', this)">
                <span class="material-symbols-rounded">layers</span> DESIGN & STYLE
            </button>
            <button class="tab-btn" onclick="switchTab('size', this)">
                <span class="material-symbols-rounded">aspect_ratio</span> SHAPE & SIZE
            </button>
            <button class="tab-btn" onclick="switchTab('lighting', this)">
                <span class="material-symbols-rounded">wb_incandescent</span> AMBILIGHT & NEON
            </button>
            <button class="tab-btn" onclick="switchTab('slideshow', this)">
                <span class="material-symbols-rounded">collections</span> SLIDESHOW & FACE
            </button>
            <button class="tab-btn" onclick="switchTab('security', this)">
                <span class="material-symbols-rounded">shield</span> SECURITY & ALARM
            </button>
            <button class="tab-btn" onclick="switchTab('system', this)">
                <span class="material-symbols-rounded">settings_cinematic_blur</span> SYSTEM
            </button>
        </div>

        <!-- Right Content Panels Area -->
        <div id="content_area">

            <!-- Tab 1: Frame Design -->
            <div id="tab-frame" class="conteiner-col active">
                <div class="sub-panel">
                    <p class="section-title">STAND MODEL</p>
                    <button onclick="setActive('model',this);cmd('model','model1',this)" class="btn1" data-group="model">MODEL 1</button>
                    <button onclick="setActive('model',this);cmd('model','model2',this)" class="btn1" data-group="model">MODEL 2</button>
                    <button onclick="setActive('model',this);cmd('model','model3',this)" class="btn1" data-group="model">MODEL 3</button>

                    <p class="section-title" style="margin-top: 25px;">TV Texture</p>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4px;margin-top: 0px;">
                        <button onclick="setActive('texture',this); cmd('texture','369104f6-cb0e-4920-a41a-ac2f8c42337e',this)" class="btn1" data-group="texture">GREY STONE</button>
                        <button onclick="setActive('texture',this); cmd('texture','<0.176, 0.176, 0.176>',this)"  class="btn1" data-group="texture">DARK GREY</button>
                        <button onclick="setActive('texture',this); cmd('texture','21d7c8a9-28c5-f436-083d-2b7d0d594dec',this)"  class="btn1" data-group="texture">CARBON FIBER</button>
                        <button onclick="setActive('texture',this); cmd('texture','704acfcc-dade-771a-c943-c295b464e2d9',this)"  class="btn1" data-group="texture">WOOD</button>
                        <button onclick="setActive('texture',this); cmd('texture','e6a5d90c-fc7c-9f4c-ffa1-e4ba195ae3b1',this)"  class="btn1" data-group="texture">PASSERELE</button>
                        <button onclick="setActive('texture',this); cmd('texture','cb3163a9-ea39-de5e-d475-2a2ab0bff4b8',this)"  class="btn1" data-group="texture">IVORY WHITE</button>
                    </div>

                    <p class="section-title" style="margin-top:25px;">STAND MODE</p>
                    <div class="legs-row">
                        <button onclick="setActive('legs',this); cmd('legs','show',this)" class="btn1" data-group="legs">STAND</button>
                        <button onclick="setActive('legs',this); cmd('legs','hide',this)" class="btn1" data-group="legs">WALL</button>
                    </div>
                </div>
                <div class="sub-panel">
                    <p class="section-title">BACK COLOR</p>
                    <div id="grid-back" class="color-grid-static" style="margin-top: 3px;">
                        <div class="color-square" style="background:#1b1b1b;" onclick="cmd('back_color','<0.0,0.0,0.0>')"></div>
                        <div class="color-square" style="background:#1a1a1a;" onclick="cmd('back_color','<0.10,0.10,0.10>')"></div>
                        <div class="color-square" style="background:#2c3e50;" onclick="cmd('back_color','<0.17,0.24,0.31>')"></div>
                        <div class="color-square" style="background:#333333;" onclick="cmd('back_color','<0.20,0.20,0.20>')"></div>
                        <div class="color-square" style="background:#8e44ad;" onclick="cmd('back_color','<0.56,0.27,0.68>')"></div>
                        <div class="color-square" style="background:#2980b9;" onclick="cmd('back_color','<0.16,0.50,0.73>')"></div>
                        <div class="color-square" style="background:#c0392b;" onclick="cmd('back_color','<0.75,0.22,0.17>')"></div>
                        <div class="color-square" style="background:#27ae60;" onclick="cmd('back_color','<0.15,0.68,0.38>')"></div>
                        <div class="color-square" style="background:#d35400;" onclick="cmd('back_color','<0.83,0.33,0.00>')"></div>
                        <div class="color-square" style="background:#7f8c8d;" onclick="cmd('back_color','<0.50,0.55,0.56>')"></div>
                        <div class="color-square" style="background:#f1c40f;" onclick="cmd('back_color','<0.95,0.77,0.06>')"></div>
                        <div class="color-square" style="background:#ffffff;" onclick="cmd('back_color','<1.0,1.0,1.0>')"></div>
                    </div>

                    <p class="section-title" style="margin-top: 25px;">Set Back Alpha</p>
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 4px;margin-top: 4px;">
                        <button onclick="cmd('back_alpha','0.0',this)" class="btn2">0%</button>
                        <button onclick="cmd('back_alpha','0.1',this)" class="btn2">10%</button>
                        <button onclick="cmd('back_alpha','0.2',this)" class="btn2">20%</button>
                    </div>

                    <p style="margin-top: 25px;" class="section-title">Webscreen Alpha</p>
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 4px;margin-top: 4px;">
                        <button onclick="cmd('web_alpha','0.0',this)" class="btn2">0%</button>
                        <button onclick="cmd('web_alpha','0.1',this)" class="btn2">10%</button>
                        <button onclick="cmd('web_alpha','0.2',this)" class="btn2">20%</button>
                    </div>

                    <p class="section-title" style="margin-top: 25px;">FRAME MODE</p>
                    <div class="legs-row">
                        <button onclick="setActive('frame',this); cmd('frame','show',this)" class="btn1" data-group="frame">SHOW</button>
                        <button onclick="setActive('frame',this); cmd('frame','hide',this)" class="btn1" data-group="frame">HIDE</button>
                    </div>

                    <div style="margin-top: auto;">
                        <button onclick="cmd('reset','visual')" class="btn1" style="font-size:14px; border-color:var(--accent); text-align: center; margin:0;">FACTORY DEFAULT</button>
                    </div>
                </div>
            </div>

            <!-- Tab 2: Lighting -->
            <div id="tab-lighting" class="conteiner-col">
                <div class="sub-panel">
                    <p class="section-title">LIGHT SWITCH</p>
                    <div class="onoff-row">
                        <button onclick="setActive('light',this);setAmbi('off',this)" class="btn1 active" data-group="light" data-mode="off">OFF</button>
                        <button onclick="setActive('light',this);setAmbi('on',this)" class="btn1" data-group="light" data-mode="on">ON</button>
                        <button onclick="setActive('light',this);setAmbi('cycle',this)" class="btn1" data-group="light" data-mode="cycle">CYCLE</button>
                    </div>

                    <p class="section-title" style="margin-top: 25px;">NEON SWITCH</p>
                    <div class="neon-state-row">
                        <button onclick="setActive('neon',this);setNeon('off',this)" class="btn1 active" data-group="neon" data-mode="off">OFF</button>
                        <button onclick="setActive('neon',this);setNeon('fixed',this)" class="btn1" data-group="neon" data-mode="fixed">ON</button>
                        <button onclick="setActive('neon',this);setNeon('cycle',this)" class="btn1" data-group="neon" data-mode="cycle">CYCLE</button>
                    </div>
 
                    <p class="section-title" style="margin-top: 25px;">CYCLE SPEED</p>
                    <div class="ctrl-row">
                        <button class="btn-adj" onclick="adjustSpeed(-0.05)">−</button>
                        <div class="btn-value">
                            <span class="val-pct" id="speed-pct">50%</span>
                            <span class="val-sub">speed</span>
                        </div>
                        <button class="btn-adj" onclick="adjustSpeed(0.05)">+</button>
                    </div>
                    <p class="section-title">MOOD PRESET</p>
                    <div class="btn-group" style="margin-bottom:20px;">
                        <button class="btn1" data-group="envlight" onclick="applyLightPreset('active', this)">ACTIVE</button>
                        <button class="btn1 active" data-group="envlight" onclick="applyLightPreset('normal', this)">NORMAL</button>
                        <button class="btn1" data-group="envlight" onclick="applyLightPreset('cozy', this)">COZY</button>
                    </div>
                </div>
                <div class="sub-panel">
                    <p class="section-title">Ambilight Glow</p>
                    <span class="label-mini">Color Palette</span>
                    
                    <div id="grid-light" class="color-grid-static" style="display:grid; grid-template-columns: repeat(6, 45px);">
                        <div class="color-square" data-color="#ffffff" style="background:#ffffff;"></div>
                        <div class="color-square" data-color="#ffdd00" style="background:#ffdd00;"></div>
                        <div class="color-square" data-color="#ff8800" style="background:#ff8800;"></div>
                        <div class="color-square" data-color="#ff0000" style="background:#ff0000;"></div>
                        <div class="color-square" data-color="#ff00aa" style="background:#ff00aa;"></div>
                        <div class="color-square" data-color="#ff00ff" style="background:#ff00ff;"></div>
                        <div class="color-square" data-color="#7a00ff" style="background:#7a00ff;"></div>
                        <div class="color-square" data-color="#0000ff" style="background:#0000ff;"></div>
                        <div class="color-square" data-color="#00aaff" style="background:#00aaff;"></div>
                        <div class="color-square" data-color="#00ffff" style="background:#00ffff;"></div>
                        <div class="color-square" data-color="#00ff88" style="background:#00ff88;"></div>
                        <div class="color-square" data-color="#00ff00" style="background:#00ff00;"></div>
                    </div>

                    <p class="section-title" style="margin-top: 25px;">LIGHT CONTROLLERS</p>
                    <div class="ctrl-row">
                        <button class="btn-adj" onclick="adjustInt(-0.1)">−</button>
                        <div class="btn-value">
                            <span class="val-pct" id="ambi-pct">50%</span>
                            <span class="val-sub">intensity</span>
                        </div>
                        <button class="btn-adj" onclick="adjustInt(0.1)">+</button>
                    </div>

                    <div class="ctrl-row">
                        <button class="btn-adj" onclick="adjustRange(-0.1)">−</button>
                        <div class="btn-value">
                            <span class="val-pct" id="range-pct">50%</span>
                            <span class="val-sub">range</span>
                        </div>
                        <button class="btn-adj" onclick="adjustRange(0.1)">+</button>
                    </div>

                    <div class="ctrl-row">
                        <button class="btn-adj" onclick="adjustFall(-0.1)">−</button>
                        <div class="btn-value">
                            <span class="val-pct" id="fall-pct">50%</span>
                            <span class="val-sub">fall</span>
                        </div>
                        <button class="btn-adj" onclick="adjustFall(0.1)">+</button>
                    </div>

                    <div class="ctrl-row">
                        <button class="btn-adj" onclick="adjustGlow(-0.1)">−</button>
                        <div class="btn-value">
                            <span class="val-pct" id="glow-pct">50%</span>
                            <span class="val-sub">glow</span>
                        </div>
                        <button class="btn-adj" onclick="adjustGlow(0.1)">+</button>
                    </div>

                    <div style="margin-top: auto;">
                        <button onclick="applyLightPreset('normal', this)" class="btn1" style="font-size:14px; border-color:var(--accent); text-align: center; margin:0;">RESET LIGHTS TO NORMAL</button>
                    </div>
                </div>
            </div>

            <!-- Tab 3: Shape & Size -->
            <div id="tab-size" class="conteiner-col">
                <div class="sub-panel">
                    <p class="section-title">Scale Control</p>
                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:6px;margin-top: 4px;">
                        <button onclick="cmd('SCALE','-0.01',this)" class="btn2">−1%</button>
                        <button onclick="cmd('SCALE','0.01',this)" class="btn2">1%</button>
                        <button onclick="cmd('SCALE','-0.05',this)" class="btn2">−5%</button>
                        <button onclick="cmd('SCALE','0.05',this)"  class="btn2">+5%</button>
                        <button onclick="cmd('SCALE','-0.10',this)" class="btn2">−10%</button>
                        <button onclick="cmd('SCALE','0.10',this)"  class="btn2">+10%</button>
                        <button onclick="cmd('SCALE','-0.20',this)" class="btn2">−20%</button>
                        <button onclick="cmd('SCALE','0.20',this)"  class="btn2">+20%</button>
                    </div>

                    <p class="section-title" style="margin-top: 25px;">PRESET SCALES</p>
                    <button onclick="setActive('env',this);cmd('PRESET','house',this)"   class="btn1" data-group="env">HOUSE SCALE</button>
                    <button onclick="setActive('env',this);cmd('PRESET','outside',this)" class="btn1" data-group="env">OUTSIDE SCALE</button>
                    <button onclick="setActive('env',this);cmd('PRESET','cinema',this)"  class="btn1" data-group="env">CINEMA SCALE</button>
                </div>
                <div class="sub-panel">
                    <p class="section-title">Shape Aspect Ratio</p>
                    <button onclick="setActive('ratio',this);cmd('ratio','1/1',this)"  class="btn1" data-group="ratio">1:1 - SQUARE</button>
                    <button onclick="setActive('ratio',this);cmd('ratio','3/2',this)"  class="btn1" data-group="ratio">3:2 - CLASSIC</button>
                    <button onclick="setActive('ratio',this);cmd('ratio','4/3',this)"  class="btn1" data-group="ratio">4:3 - RETRO</button>
                    <button onclick="setActive('ratio',this);cmd('ratio','16/9',this)" class="btn1" data-group="ratio">16:9 - FULL HD</button>
                    <button onclick="setActive('ratio',this);cmd('ratio','21/9',this)" class="btn1" data-group="ratio">21:9 - CINEMA SCOPE</button>
                    <button onclick="setActive('ratio',this);cmd('ratio','32/9',this)"  class="btn1" data-group="ratio">32:9 - DUAL ULTRAWIDE</button>
             
                    <div style="margin-top: auto;">
                        <button onclick="cmd('reset','size')" class="btn1" style="font-size:14px; border-color:var(--accent); text-align: center; margin:0;">FACTORY DEFAULT</button>
                    </div>
                </div>
            </div>

            <!-- Tab 4: Slideshow & Face Mode (NEW) -->
            <div id="tab-slideshow" class="conteiner-col">
                <div class="sub-panel">
                    <p class="section-title">Screen Face Mode</p>
                    <span class="label-mini">Display Target</span>
                    <div class="legs-row" style="margin-bottom: 20px;">
                        <button onclick="setActive('screenmode',this); setScreenMode('web',this)" class="btn1 active" data-group="screenmode">WEB VIEW</button>
                        <button onclick="setActive('screenmode',this); setScreenMode('sl',this)" class="btn1" data-group="screenmode">SL FACE</button>
                    </div>

                    <span class="label-mini">SL Face Custom Texture UUID</span>
                    <div style="display:flex; gap:8px; margin-bottom: 10px;">
                        <input type="text" id="sl-texture-input" placeholder="Paste texture UUID..." style="flex:1; background:rgba(0,0,0,0.3); border:1px solid var(--glass-border); color:#fff; padding:10px; border-radius:8px; font-family:'Inter'; font-size:13px;">
                        <button onclick="saveSlTexture()" class="btn2" style="padding: 10px 16px;">Save</button>
                    </div>
                    <p class="hint-text" style="color: rgba(255,255,255,0.6); font-size:11px; line-height:1.4;">
                        When switching to SL Face, the web browser becomes transparent and this UUID texture is displayed on the back face.
                    </p>
                </div>

                <div class="sub-panel">
                    <p class="section-title">Slideshow Config</p>
                    
                    <span class="label-mini">Image Source</span>
                    <select id="ss-source" class="btn1" style="background: rgba(0,0,0,0.4); margin-bottom: 12px; cursor: pointer;" onchange="toggleSourceInput()">
                        <option value="notecard">Read from Prim Notecard</option>
                        <option value="web">Send UUIDs from Web Panel</option>
                    </select>

                    <div id="ss-web-container" style="display:none; margin-bottom: 12px;">
                        <span class="label-mini">Paste Texture UUIDs (comma separated)</span>
                        <textarea id="ss-uuids" placeholder="uuid1, uuid2, uuid3..." style="width:100%; height:70px; background:rgba(0,0,0,0.4); color:#fff; border:1px solid var(--glass-border); border-radius:8px; padding:8px; font-family:'Inter'; font-size:12px; resize:none;"></textarea>
                    </div>

                    <span class="label-mini">Interval (Seconds)</span>
                    <input type="number" id="ss-interval" value="8" min="2" max="60" class="btn1" style="background: rgba(0,0,0,0.4); text-align: center; margin-bottom: 20px;">

                    <div style="display:flex; gap:10px; margin-top: auto;">
                        <button onclick="applyAndStartSlideshow()" class="btn1" style="background:var(--success); color:#000; font-weight:600; border:none; margin:0; flex:1;">START SLIDESHOW</button>
                    </div>

<!-- Botão no painel de definições -->
<div style="margin-top: 15px;">
    <button onclick="playServerJsonSlideshow()" class="btn1" style="background: var(--accent); color: #000; font-weight: 600; border:none; width:100%; text-align:center;">
        LOAD JSON FROM SERVER & START
    </button>
</div>

                </div>
            </div>

            <!-- Tab 5: Security -->
            <div id="tab-security" class="conteiner-col">
                <div class="sub-panel" style="max-width: 600px; margin: 0 auto;">
                    <p class="section-title">HOUSE ALARME</p>
                    <div class="btn-group">
                        <button onclick="setActive('alert',this);cmd('alert','off',this)" class="btn1" data-group="alert">DISABLE</button>
                        <button onclick="setActive('alert',this);cmd('alert','on',this)" class="btn1 active" data-group="alert">ENABLE</button>
                    </div>
                    <p class="hint-text" style="color: rgba(255,255,255,0.7); font-size:12px; margin-top:6px; text-align:center; line-height:1.4;">
                        Enables or disables real-time proximity alerts when someone approach your property.
                    </p>

                    <p class="section-title" style="margin-top: 20px;">SENSOR RANGE (METERS)</p>
                    <div class="ctrl-row">
                        <button class="btn-adj" onclick="adjustSensorRange(-1)">−</button>
                        <div class="btn-value">
                            <span class="val-pct" id="sensor-range-val">15m</span>
                            <span class="val-sub">distance</span>
                        </div>
                        <button class="btn-adj" onclick="adjustSensorRange(1)">+</button>
                    </div>
                    <p class="hint-text" style="color: rgba(255,255,255,0.7); font-size:12px; margin-top:6px; text-align:center; line-height:1.4;">
                        Adjusts the maximum radius in meters used to detect nearby avatars.
                    </p>

                    <p class="section-title" style="margin-top: 20px;">LOCK TV</p>
                    <div class="btn-group">
                        <button onclick="setActive('lock',this);cmd('lock','off',this)" class="btn1" data-group="lock">UNLOCK</button>
                        <button onclick="setActive('lock',this);cmd('lock','on',this)" class="btn1 active" data-group="lock">LOCK</button>
                    </div>
                    <p class="hint-text" style="color: rgba(255,255,255,0.7); font-size:12px; margin-top:6px; text-align:center; line-height:1.4;">
                        Restricts Power button access, settings modifications, and playback controls exclusively to the device owner.
                    </p>

                    <p class="section-title" style="margin-top: 20px;">NAV BAR</p>
                    <div class="btn-group">
                        <button onclick="setActive('nav',this);cmd('browser','hide',this)" class="btn1 active" data-group="nav">HIDE</button>
                        <button onclick="setActive('nav',this);cmd('browser','show',this)" class="btn1" data-group="nav">SHOW</button>
                    </div>
                    <p class="hint-text" style="color: rgba(255,255,255,0.7); font-size:12px; margin-top:6px; text-align:center; line-height:1.4;">
                        Hides or shows the SL Browser navigation bar, useful to navigate external sites.
                    </p>
                </div>
            </div>

            <!-- Tab 6: System -->
            <div id="tab-system" class="conteiner-col" style="width: 450px; margin: auto;">
                <div class="sub-panel">
                    <p class="section-title">SYSTEM ACTIONS</p>
                    
                    <button onclick="cmd('visualSizeReset','',this)" class="btn1">DEFAULT SETTING</button>
                    <p class="hint-text" style="color: rgba(255,255,255,0.7); font-size:12px; margin: 4px 0 16px 0; text-align:center; line-height:1.4;">
                        Restores factory default visual parameters and layout configurations.
                    </p>

                    <button onclick="cmd('fullreset','',this)" class="btn1">RESET SCRIPTS</button>
                    <p class="hint-text" style="color: rgba(255,255,255,0.7); font-size:12px; margin: 4px 0 16px 0; text-align:center; line-height:1.4;">
                        Restarts all scripts to resolve state lag or communication errors.
                    </p>

                    <button onclick="cmd('kill','',this)" class="btn1" style="border-color: rgba(255,107,107,0.4); color: #ff6b6b;">DELETE TV</button>
                    <p class="hint-text" style="color: rgba(255,255,255,0.7); font-size:12px; margin: 4px 0 0 0; text-align:center; line-height:1.4;">
                        Permanently deletes this TV object from the region.
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Botão Flutuante de Toggle -->
<button id="floating-toggle-btn" onclick="toggleScreenMode()">
    <span class="material-symbols-rounded" style="font-size: 18px;">sync_alt</span>
    <span id="toggle-btn-label">SWITCH TO SL FACE</span>
</button>


<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>

    const TV_ID = "<%= tvId %>";


let slideshowTimer = null;
let currentSlideIndex = 0;
let cachedUuids = [];

window.playServerJsonSlideshow = function() {
    const intervalSeconds = parseInt(document.getElementById('ss-interval').value) || 8;

    // 1. Vai buscar os UUIDs ao servidor (caso ainda não estejam em cache)
    if (cachedUuids.length > 0) {
        startLoop(intervalSeconds);
        return;
    }

    $.ajax({
        type: 'GET',
        url: '/get-textures-json',
        success: function(res) {
            if (!res.uuids || res.uuids.length === 0) {
                alert("O ficheiro JSON está vazio.");
                return;
            }

            // Guarda os UUIDs em cache para as próximas repetições
            cachedUuids = res.uuids;
            currentSlideIndex = 0;
            
            // Inicia o ciclo de envio
            startLoop(intervalSeconds);
            alert(`Slideshow iniciado com ${cachedUuids.length} texturas do servidor!`);
        },
        error: function() {
            alert("Erro ao obter o ficheiro JSON do servidor.");
        }
    });
};

function startLoop(seconds) {
    if (slideshowTimer) clearInterval(slideshowTimer);

    // Envia o primeiro slide imediatamente
    sendNextServerSlide();

    // Configura o temporizador para enviar os seguintes um a um
    slideshowTimer = setInterval(() => {
        sendNextServerSlide();
    }, seconds * 1000);
}

function sendNextServerSlide() {
    if (cachedUuids.length === 0) return;
console.log(cachedUuids)
    const uuid = cachedUuids[currentSlideIndex];
    console.log(uuid)
    // Usa a tua função cmd() existente para enviar um UUID de cada vez
    cmd('set_slide', uuid);

    // Avança para o próximo índice (faz loop automático ao chegar ao fim)
    currentSlideIndex = (currentSlideIndex + 1) % cachedUuids.length;
}

// Opcional: Se quiseres uma função para parar o slideshow
window.stopServerJsonSlideshow = function() {
    if (slideshowTimer) {
        clearInterval(slideshowTimer);
        slideshowTimer = null;
        alert("Slideshow parado.");
    }
};
////////////////////////////////////////////////
    function switchTab(tabId, el) {
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('.conteiner-col').forEach(panel => panel.classList.remove('active'));
        
        el.classList.add('active');
        document.getElementById('tab-' + tabId).classList.add('active');
    }

    let selectedHex = null;
    let currentScreenMode = 'web';
    let ambiState   = 'off';
    let ambiOn      = false;
    let ambiInt     = 0.5;
    let neonState   = 'off';
    let neonSpeed   = 0.10;
    let fallValue   = 0.5;
    let glowValue   = 0.5;
    let rangeValue  = 0.5;
    let speedValue  = 0.5;

    const LIGHT_PRESETS = {
        active: { color: '#ff00aa', ambiMode: 'cycle', neonMode: 'cycle', ambiInt: 0.9,  rangeValue: 0.8,  fallValue: 0.4, glowValue: 0.4,  speedValue: 0.10 },
        normal: { color: '#ffffff', ambiMode: 'on',    neonMode: 'off',   ambiInt: 0.5,  rangeValue: 0.5,  fallValue: 1.0, glowValue: 0.3,  speedValue: 0.50 },
        cozy:   { color: '#ff8800', ambiMode: 'on',    neonMode: 'off',   ambiInt: 0.25, rangeValue: 0.35, fallValue: 1.4, glowValue: 0.15, speedValue: 0.50 },
        inactive:   {}
    };

    function stepValue(current, delta) {
        const pct  = Math.round(current * 100);
        const step = Math.round(delta * 100);
        return Math.min(100, Math.max(0, pct + step)) / 100;
    }

    window.adjustInt = function(v) {
        ambiInt = stepValue(ambiInt, v);
        updateUI();
        if (ambiOn && selectedHex) cmd('ambi_intensity', ambiInt.toFixed(2));
    };
    window.adjustFall = function(v) {
        fallValue = stepValue(fallValue, v);
        document.getElementById('fall-pct').textContent = Math.round(fallValue * 100) + '%';
        cmd('ambi_fall', fallValue.toFixed(2));
    };
    window.adjustRange = function(v) {
        rangeValue = stepValue(rangeValue, v);
        document.getElementById('range-pct').textContent = Math.round(rangeValue * 100) + '%';
        cmd('ambi_range', rangeValue.toFixed(2));
    };
    window.adjustSpeed = function(v) {
        speedValue = stepValue(speedValue, v);
        document.getElementById('speed-pct').textContent = Math.round(speedValue * 100) + '%';
        updateUI();
        cmd('neon_speed', speedValue.toFixed(2));
    };
    window.adjustGlow = function(v) {
        glowValue = stepValue(glowValue, v);
        document.getElementById('glow-pct').textContent = Math.round(glowValue * 100) + '%';
        cmd('GLOW_ON', glowValue.toFixed(2));
    };

    function hexToSL(hex) {
        const r = (parseInt(hex.slice(1,3),16)/255).toFixed(2);
        const g = (parseInt(hex.slice(3,5),16)/255).toFixed(2);
        const b = (parseInt(hex.slice(5,7),16)/255).toFixed(2);
        return '<'+r+','+g+','+b+'>';
    }

    function updateUI() {
        const hex = selectedHex || '#333333';

        const ambiPct = document.getElementById('ambi-pct');
        if (ambiPct) ambiPct.textContent = Math.round(ambiInt * 100) + '%';

        const fallPct = document.getElementById('fall-pct');
        if (fallPct) fallPct.textContent = Math.round(fallValue * 100) + '%';

        const rangePct = document.getElementById('range-pct');
        if (rangePct) rangePct.textContent = Math.round(rangeValue * 100) + '%';

        const speedPctEl = document.getElementById('speed-pct');
        if (speedPctEl) speedPctEl.textContent = Math.round(speedValue * 100) + '%';
    }

    window.setActive = function(group, el) {
        document.querySelectorAll(`[data-group="${group}"]`).forEach(b => b.classList.remove('active'));
        el.classList.add('active');
    };

    window.setAmbi = function(state, el) {
        ambiState = state;
        ambiOn = (state !== 'off');
        if (state === 'off') {
            cmd('LIGHT_OFF', '', el);
        } else if (state === 'on') {
            if (selectedHex) cmd('LIGHT_ON', hexToSL(selectedHex), el);
        } else if (state === 'cycle') {
            cmd('neon_speed', speedValue.toFixed(2));
            if (selectedHex) cmd('LIGHT_CYCLE', hexToSL(selectedHex), el);
        }
    };

    window.setNeon = function(state, el) {
        neonState = state;
        if (state === 'off') {
            cmd('NEON_OFF', '', el);
        } else if (state === 'fixed') {
            if (selectedHex) cmd('NEON_ON', hexToSL(selectedHex), el);
        } else if (state === 'cycle') {
            cmd('neon_speed', speedValue.toFixed(2));
            if (selectedHex) cmd('NEON_CYCLE', hexToSL(selectedHex), el);
        }
    };

    window.applyLightPreset = function(name, el) {
        const p = LIGHT_PRESETS[name];
        if (!p) return;

        document.querySelectorAll('[data-group="envlight"]').forEach(b => b.classList.remove('active'));
        if (el) el.classList.add('active');

        selectedHex = p.color;
        ambiInt = p.ambiInt; rangeValue = p.rangeValue; fallValue = p.fallValue;
        glowValue = p.glowValue; speedValue = p.speedValue;
        ambiState = p.ambiMode; ambiOn = (p.ambiMode !== 'off');
        neonState = p.neonMode;
        updateUI();

        document.querySelectorAll('#grid-light .color-square').forEach(s =>
            s.classList.toggle('selected', s.dataset.color === p.color));
        document.querySelectorAll('[data-group="light"]').forEach(b =>
            b.classList.toggle('active', b.dataset.mode === p.ambiMode));
        document.querySelectorAll('[data-group="neon"]').forEach(b =>
            b.classList.toggle('active', b.dataset.mode === p.neonMode));

        cmd('LIGHT_PRESET', name, el);
    };

    let sensorRange = 15.0;
    window.adjustSensorRange = function(v) {
        sensorRange = Math.min(50, Math.max(1, sensorRange + v));
        document.getElementById('sensor-range-val').textContent = sensorRange + 'm';
        cmd('sensor_range', sensorRange.toString());
    };

    window.setScreenMode = function(mode, el) {
        currentScreenMode = mode;
        const btn = document.getElementById('floating-toggle-btn');
        const label = document.getElementById('toggle-btn-label');

        if (mode === 'sl') {
            if (btn) btn.style.display = 'flex';
            if (label) label.textContent = 'SWITCH TO WEB VIEW';
        } else {
            if (btn) btn.style.display = 'none';
            if (label) label.textContent = 'SWITCH TO SL FACE';
        }

        cmd('screen_mode', mode, el);
    };

    function toggleScreenMode() {
        if (currentScreenMode === 'web') {
            setScreenMode('sl');
        } else {
            setScreenMode('web');
        }
    }

    window.saveSlTexture = function() {
        const uuid = document.getElementById('sl-texture-input').value.trim();
        if (!uuid) {
            alert('Please enter a valid texture UUID.');
            return;
        }
        cmd('sl_texture', uuid);
    };

    window.toggleSourceInput = function() {
        const source = document.getElementById('ss-source').value;
        document.getElementById('ss-web-container').style.display = (source === 'web') ? 'block' : 'none';
    };

    window.applyAndStartSlideshow = function() {
        const source = document.getElementById('ss-source').value;
        const interval = document.getElementById('ss-interval').value;
        const uuids = document.getElementById('ss-uuids').value;
        const payload = source + "|" + interval + "|" + uuids;
        cmd('slideshow_config', payload);
    };

    window.cmd = function(command, value, el) {
        if (!TV_ID || TV_ID === 'undefined') return;
        if (el) { $(el).addClass('sent'); setTimeout(() => $(el).removeClass('sent'), 300); }
        $.ajax({
            type: 'POST', url: '/send-command', contentType: 'application/json',
            data: JSON.stringify({ command, value, object_id: TV_ID }),
            success: function() {
                $('#connection-container').addClass('online-active');
                $('#status-text').text('ONLINE').css('color','#2ecc71');
                $('#warning-msg').hide();
            },
            error: function() {
                $('#connection-container').removeClass('online-active');
                $('#status-text').text('OFFLINE').css('color','var(--error)');
                $('#warning-msg').show();
            }
        });
    };

    const lContainer = document.getElementById('grid-light');
    if (lContainer) {
        const squares = lContainer.querySelectorAll('.color-square');
        squares.forEach(d => {
            d.onclick = () => {
                const hex = d.dataset.color;
                selectedHex = hex;
                squares.forEach(s => s.classList.remove('selected'));
                d.classList.add('selected');
                updateUI();
                if (ambiState === 'cycle') {
                    cmd('LIGHT_CYCLE', hexToSL(hex));
                } else if (ambiState === 'on') {
                    cmd('LIGHT_ON', hexToSL(hex));
                }
                if (neonState === 'fixed') {
                    cmd('NEON_ON', hexToSL(hex));
                }
            };
        });
        const first = squares[0];
        if (first) {
            first.classList.add('selected');
            selectedHex = first.dataset.color;
        }
    }

    $(document).ready(function() {
        updateUI();
    });

</script>
</body>
</html>